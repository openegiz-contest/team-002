  "description": "Created by QazMine Team. Sensor flow: MQTT -> Eclipse Ditto -> Telegraf -> InfluxDB -> Grafana. Synthetic mine.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ore to crusher, t",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "masst"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\")\n |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n |> filter(fn: (r) => r.thingId == \"org.qazmine.flow:mine\" and r._field == \"value_ore_delivered_properties_value\")\n |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
